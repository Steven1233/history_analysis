# ── 运行时数据与缓存（程序数据目录，不入库）─────────────────────────
.histsim/
*.log

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.venv/

# ── 打包构建产物（setup.exe 通过 GitHub Release 分发，不入库）────────
packaging/build/
packaging/dist/
packaging/installer/
release/
# 未指定 --distpath/--workpath 时 PyInstaller 会落到仓库根
/build/
/dist/

# ── 数据文件（体积大，靠登记数据源使用，不入库）──────────────────────
*.nc
*.npz

# ── 工具痕迹 ──────────────────────────────────────────────────────────
.stfolder/
